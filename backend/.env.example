PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/saarthi
JWT_SECRET=replace_with_a_long_random_secret
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_test_secret
# Separate secret configured for the Razorpay Dashboard webhook endpoint.
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.8-flash
GEMINI_DAMAGE_MODEL=gemini-3.6-flash
# Optional persistent volume mount path for uploaded vehicle and inspection photos.
# Example: /var/lib/saarthi/uploads
SAARTHI_UPLOAD_DIR=
